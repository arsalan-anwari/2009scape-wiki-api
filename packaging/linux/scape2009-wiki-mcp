#!/bin/sh
#
# Answer an MCP client over stdio, reading the dataset the package installed. Set
# WIKI_API_MCP_TRANSPORT=http to reach the tools over a port instead.

: "${WIKI_API_CONFIG_DIR:=/etc/scape2009-wiki-api}"
export WIKI_API_CONFIG_DIR

exec /usr/lib/scape2009-wiki-api/scape2009-wiki-api mcp "$@"
