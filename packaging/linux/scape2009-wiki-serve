#!/bin/sh
#
# Serve what this machine has installed. Which surfaces, which dataset and which key
# are lines of /etc/scape2009-wiki-api/deploy.json, each overridable by a WIKI_API_
# environment variable.

: "${WIKI_API_CONFIG_DIR:=/etc/scape2009-wiki-api}"
export WIKI_API_CONFIG_DIR

exec /usr/lib/scape2009-wiki-api/scape2009-wiki-api serve "$@"
